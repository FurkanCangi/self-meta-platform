    "outDir": ".tmp/report-v2",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "incremental": false,
    "isolatedModules": false
  },
  "include": [
    "scripts/report-v2-cases.ts",
    "scripts/run-report-v2-tests.ts",
    "scripts/run-report-v2-blind.ts",
