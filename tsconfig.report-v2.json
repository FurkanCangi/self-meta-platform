    "scripts/run-report-v2-quality-consolidation.ts",
    "scripts/run-report-v2-final-consistency.ts",
    "scripts/run-report-v2-production-readiness.ts",
    "scripts/run-report-v2-plain-clinical-turkish.ts",
    "scripts/run-report-v2-plain-integration-qa.ts",
    "scripts/run-report-v2-human-readability-acceptance.ts",
    "scripts/run-report-v2-human-clinical-editor-pass.ts",
    "scripts/run-report-v2-clinical-content-release-candidate.ts",
